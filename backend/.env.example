# ===== RxGate backend configuration =====
# Copy to backend/.env and fill in. Never commit backend/.env.
#
#   cp backend/.env.example backend/.env

PORT=3001

# REQUIRED. The server refuses to boot if this is missing or shorter than 32
# characters — there is deliberately no default, because a secret baked into the
# repository would let anyone who can read the source forge an admin token.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-48-byte-hex-string

# Public origin of the React app. Used to build Stripe success/cancel URLs and
# emailed payment links, so it must match how users actually reach the frontend.
FRONTEND_URL=http://localhost:5173

# ===== Payments (Stripe) =====
# Leave BOTH blank to run in mock mode. With no STRIPE_SECRET_KEY the app serves a
# simulated checkout at /payment/mock so the whole approve -> pay -> fulfil flow
# can be demonstrated without test keys.
#
# As soon as STRIPE_SECRET_KEY is set, the mock endpoints return 404 and real
# Stripe Checkout is used instead.
#
# Test keys (safe to use locally): https://dashboard.stripe.com/test/apikeys
# Webhook secret: `stripe listen --forward-to localhost:3001/api/orders/webhook`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Email (Nodemailer / SMTP) =====
# Blank EMAIL_HOST makes email delivery a logged no-op, so the app runs without
# SMTP credentials. Gmail requires an App Password, not your account password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ===== OCR (optional) =====
# Tesseract.js downloads English language data on first use. Point this at a local
# directory containing eng.traineddata to run OCR without outbound internet.
# TESSERACT_LANG_PATH=./tessdata